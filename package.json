{
  "name": "cakecraft",
  "version": "0.1.0",
  "private": true,
  "description": "CakeCraft - Plataforma Web para montagem de bolos customizados com precificacao dinamica e gestao de producao em tempo real",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @cakecraft/api",
    "build:api": "npm run build -w @cakecraft/api",
    "test:api": "npm run test -w @cakecraft/api",
    "test:e2e:api": "npm run test:e2e -w @cakecraft/api",
    "dev:web": "npm run dev -w @cakecraft/web",
    "build:web": "npm run build -w @cakecraft/web",
    "test:web": "npm run test -w @cakecraft/web",
    "lint:web": "npm run lint -w @cakecraft/web",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "webpack": "^5.105.4",
    "multer": "^2.4.0",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "bcrypt": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
