{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.35 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cakecraft_http_request_duration_seconds_bucket{route=\"/api/pricing/calculate\"}[5m])) by (le))",
          "legendFormat": "P95 /api/pricing/calculate",
          "refId": "A"
        }
      ],
      "title": "RNF01 - Latencia P95 Precificacao (SLA <= 0.5s)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 99.5 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "100 * (1 - ((sum(rate(cakecraft_http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(cakecraft_http_requests_total[5m])), 0.000001)))",
          "legendFormat": "Disponibilidade HTTP",
          "refId": "A"
        }
      ],
      "title": "RNF07 - Disponibilidade HTTP (SLA >= 99.5%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "cakecraft_orders_created_total",
          "legendFormat": "Pedidos criados",
          "refId": "A"
        }
      ],
      "title": "UC01 - Total de Pedidos Criados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "cakecraft_process_resident_memory_bytes",
          "legendFormat": "RSS API",
          "refId": "A"
        }
      ],
      "title": "Memoria RSS da API Node.js",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(cakecraft_http_requests_total[1m])) by (method, route, status_code)",
          "legendFormat": "{{method}} {{route}} ({{status_code}})",
          "refId": "A"
        }
      ],
      "title": "Throughput HTTP por Rota e Status (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(cakecraft_pix_webhooks_processed_total) by (event)",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "title": "RN03 - Webhooks PIX Asaas por Evento",
      "type": "timeseries"
    }
  ],
