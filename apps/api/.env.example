# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# O .env real nunca e versionado (ver .gitignore na raiz).

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3001

# Origem autorizada no CORS (frontend Next.js em desenvolvimento)
CORS_ORIGIN=http://localhost:3000

# Postgres - as credenciais abaixo batem com o docker-compose de desenvolvimento
DATABASE_URL=postgresql://cakecraft:cakecraft@localhost:5432/cakecraft?schema=public

# Redis - cache de catalogo e Pub/Sub de eventos de dominio
REDIS_URL=redis://localhost:6379

# JWT - RF01/RNF04. Troque estes valores antes de qualquer deploy real.
# Os tokens sao entregues via cookie httpOnly, nunca no corpo da resposta.
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-outro-valor-tambem-por-algo-aleatorio
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Senha inicial do administrador no prisma seed (obrigatoria em producao com >= 12 caracteres)
ADMIN_SEED_PASSWORD=troque-esta-senha-admin
# Relay SMTP para e-mails transacionais (recuperacao de senha etc.)
# Provedor padrao: Brevo (smtp-relay.brevo.com, porta 587) - criar uma
# chave SMTP em https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp-brevo
SMTP_PASSWORD=sua-chave-smtp-brevo
SMTP_FROM="CakeCraft <no-reply@cakecraft.dev>"

# Rate limiting global por IP (RNF05) - login e cadastro possuem teto mais estrito (10 req/min)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Gateway PIX Asaas (RF07 / RN03) - em dev sem chave real opera em simulacao Sandbox local
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=sandbox-asaas-local-dev
ASAAS_WEBHOOK_TOKEN=token-webhook-asaas-local-dev
ASAAS_DEFAULT_CPF_CNPJ=24971563792

# Diretorio de armazenamento de imagens de papel de arroz (RF05)
UPLOAD_DIR=uploads
