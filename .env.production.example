# Copie para .env.production na VM Microsoft Azure (nunca versione credenciais reais).
# O Caddy emite certificado TLS Let's Encrypt automaticamente para APP_DOMAIN.

APP_DOMAIN=cakecraft.duckdns.org

# Imagens publicadas pelo GitHub Actions no GitHub Container Registry (GHCR)
API_IMAGE=ghcr.io/cmagnodutra/cakecraft-api:latest
API_MIGRATE_IMAGE=ghcr.io/cmagnodutra/cakecraft-api-migrate:latest
WEB_IMAGE=ghcr.io/cmagnodutra/cakecraft-web:latest

# PostgreSQL 16 e Redis 7 (rede interna isolada backend_net)
POSTGRES_USER=cakecraft
POSTGRES_PASSWORD=gere-uma-senha-forte-com-openssl-rand-hex-24
POSTGRES_DB=cakecraft
REDIS_PASSWORD=gere-outra-senha-forte-com-openssl-rand-hex-24

# Autenticacao JWT httpOnly + Bcrypt 12 (RNF04)
JWT_ACCESS_SECRET=gere-segredo-jwt-acesso-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gere-segredo-jwt-refresh-distinto-com-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Relay SMTP transacional (Brevo gratuito - 300 e-mails/dia)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-login-smtp@smtp-brevo.com
SMTP_PASSWORD=sua-chave-smtp-real-brevo
SMTP_FROM="CakeCraft <no-reply@cakecraft.duckdns.org>"

# Rate limiting global (RNF05)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Gateway PIX Asaas (RF07 / RN03)
# Para homologacao academica com QR Code real de Sandbox use api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=$aact_sua_chave_real_do_asaas_sandbox_ou_producao
ASAAS_WEBHOOK_TOKEN=gere-um-token-secreto-exclusivo-para-o-webhook-asaas
ASAAS_DEFAULT_CPF_CNPJ=24971563792

# Painel de observabilidade Grafana (https://APP_DOMAIN/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=gere-uma-senha-forte-para-o-painel-grafana
